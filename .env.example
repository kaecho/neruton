# ==============================================================================
# Neruton v0.4.0 Server & Cloudflare Tunnel Configuration
# Copy to `.env` before running `docker compose pull && docker compose up -d`:
#   cp .env.example .env
# ==============================================================================

# GHCR Docker image tag for neruton-server & neruton-web (e.g. latest, v0.4.0)
NERUTON_IMAGE_TAG=latest

# Base domain used for wildcard subdomain routing (<prefix>.<NERUTON_BASE_DOMAIN>)
NERUTON_BASE_DOMAIN=moer.eu.org

# Hostname for the Neruton Web Dashboard, Management API, and Tunnel WSS endpoint
NERUTON_PANEL_HOST=neruton.moer.eu.org

# Public URL scheme advertised by neruton-server (https behind Cloudflare / TLS proxy).
# Also controls the `Secure` attribute on the `neruton_session` cookie.
NERUTON_PUBLIC_SCHEME=https

# ------------------------------------------------------------------------------
# Authentication, Accounts & Tunnel Token Policy (persisted in /data/state.json)
# ------------------------------------------------------------------------------

# Require a valid tunnel token when CLI clients connect to /_neruton/tunnel.
# Enabled by default (`true`). Set to `false` for initial open mode, or toggle
# live at any time in the Web UI under Settings (/settings).
NERUTON_REQUIRE_AUTH=true

# Initial administrator username used when bootstrapping an empty state.
NERUTON_ADMIN_USER=admin

# Initial administrator password (min 8 chars) for unattended first-run bootstrap.
# Leave empty to complete interactive first-run administrator setup in the Web UI.
NERUTON_ADMIN_PASSWORD=

# Optional HMAC-SHA256 signing secret for Web session cookies (`neruton_session`).
# Leave empty to auto-generate a random 32-byte hex secret persisted in /data/state.json.
NERUTON_SESSION_SECRET=

# Optional legacy/master Bearer token for tunnel registration.
# Works alongside per-user tunnel tokens (`ntk_...`) managed in the Web UI.
NERUTON_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Cloudflare Tunnel (Zero Exposed Host Ports)
# ------------------------------------------------------------------------------

# Cloudflare Tunnel token (from Cloudflare Zero Trust or `cf tunnels token get <id>`).
# Remote-managed ingress should route both:
#   - ${NERUTON_PANEL_HOST}     -> http://neruton-server:8080
#   - *.${NERUTON_BASE_DOMAIN}  -> http://neruton-server:8080
# Zero host ports need to be exposed.
CLOUDFLARED_TUNNEL_TOKEN=
