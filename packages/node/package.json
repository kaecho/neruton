{
  "name": "neruton",
  "version": "0.4.0",
  "description": "Native Node.js/TypeScript client and CLI for Neruton intranet tunnels & wildcard proxy",
  "keywords": [
    "neruton",
    "tunnel",
    "reverse-proxy",
    "intranet",
    "localhost",
    "yamux",
    "websocket",
    "cloudflared",
    "ngrok"
  ],
  "homepage": "https://github.com/kaecho/neruton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaecho/neruton.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/kaecho/neruton/issues"
  },
  "license": "MIT",
  "author": "neruton contributors",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "bin": {
    "neruton": "dist/esm/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit && tsc -p tsconfig.cjs.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3"
  }
}
